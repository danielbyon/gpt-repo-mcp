{
  "name": "gpt-repo-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Read-mostly MCP server for controlled ChatGPT access to approved local repositories with opt-in safe file and git operations.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CAHN91/gpt-repo-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/CAHN91/gpt-repo-mcp/issues"
  },
  "homepage": "https://github.com/CAHN91/gpt-repo-mcp#readme",
  "keywords": [
    "mcp",
    "chatgpt",
    "developer-tools",
    "repository",
    "local-first"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "dist/server.js",
  "bin": {
    "gpt-repo": "dist/cli/connect-gpt.js",
    "connect-gpt": "dist/cli/connect-gpt.js"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "mcp": "GPT_REPO_CONFIG=./config.local.json PORT=8787 npm run dev",
    "tunnel": "ngrok http 8787 --log=stdout",
    "connect": "node scripts/connect-dev.mjs",
    "connect:cloudflare": "PORT=8788 node scripts/connect-cloudflare.mjs",
    "connect:secure": "node scripts/connect-secure.mjs",
    "add": "node dist/cli/connect-gpt.js add",
    "remove": "node dist/cli/connect-gpt.js remove",
    "list": "node dist/cli/connect-gpt.js list",
    "check:config": "node dist/cli/connect-gpt.js check",
    "config:reload": "node dist/cli/connect-gpt.js config reload",
    "doctor": "npm run build && node dist/cli/connect-gpt.js doctor",
    "build": "tsup src/server.ts --format esm --dts --clean --external typescript && tsup src/cli/connect-gpt.ts --format esm --out-dir dist/cli --external typescript && node scripts/build-windows-process-host.mjs && node scripts/build-windows-configuration-admin-host.mjs",
    "verify:package-archive": "node scripts/verify-windows-package.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:public": "node scripts/check-public.mjs",
    "security:scan": "node scripts/oss-security-scan.mjs",
    "test": "vitest run",
    "test:configuration-admin:coverage": "vitest run tests/configuration-source-identity.test.ts tests/configuration-admin-protocol.test.ts tests/configuration-admin-client.test.ts tests/configuration-admin-controller.test.ts tests/configuration-admin-cli.test.ts --coverage.enabled --coverage.provider=v8 --coverage.include=src/config/config-source-identity.ts --coverage.include=src/runtime/configuration-admin-protocol.ts --coverage.include=src/runtime/configuration-admin-client.ts --coverage.include=src/runtime/configuration-admin-controller.ts --coverage.thresholds.lines=90 --coverage.thresholds.statements=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.perFile=true",
    "verify:dist": "npm run build && node scripts/smoke-dist-server.mjs",
    "predev": "node scripts/build-windows-process-host.mjs && node scripts/build-windows-configuration-admin-host.mjs",
    "pretest": "node scripts/build-windows-process-host.mjs && node scripts/build-windows-process-host.mjs --test && node scripts/build-windows-configuration-admin-host.mjs && node scripts/build-windows-configuration-admin-host.mjs --test",
    "issue:ready": "node scripts/check-issue-readiness.mjs",
    "test:issue-readiness": "node --test scripts/tests/issue-readiness-checks.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.1.0",
    "ignore": "^7.0.5",
    "js-yaml": "^4.3.2",
    "typescript": "^5.9.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.1",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.14"
  },
  "files": [
    "package.json",
    "README.md",
    "LICENSE",
    "dist/server.js",
    "dist/cli/connect-gpt.js",
    "dist/windows-process-host.exe",
    "dist/windows-configuration-admin-host.exe"
  ]
}
